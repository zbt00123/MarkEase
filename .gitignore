# 忽略 Python 缓存
__pycache__/
*.py[cod]

# 忽略虚拟环境
venv/
env/
logs/
# 忽略打包输出
dist/
build/
out/
*.spec
# ★ 精确放行：三平台打包 spec 必须纳入版本管理
!MarkEase.spec
!packaging/*.spec

# 本地验证 / 权限修复临时产物
_verify_dist/
_verify_build/
_build_check/
_acl_reports/

# 忽略发布文件（已存在于 GitHub Releases）
release/
*.7z

# 忽略日志
logs/

# 忽略开发文档
开发手册/

# 忽略脚本目录，仅精确放行发布相关脚本
scripts/*
!scripts/1.一键打包.py

*.pyc
*.pyo
.venv/

# 输入法/第三方工具在本目录留下的日志
debug.log

tree.txt
# CI 下载的临时产物
_ci_linux/


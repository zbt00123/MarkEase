# 忽略 Python 缓存
__pycache__/
*.py[cod]

# 忽略虚拟环境
venv/
env/
logs/
# 忽略打包输出
dist/
build/
out/
*.spec
# ★ 精确放行：三平台打包 spec 必须纳入版本管理
!MarkEase.spec
!packaging/*.spec

# 本地验证 / 权限修复临时产物
_verify_dist/
_verify_build/
_build_check/
_acl_reports/

# 忽略发布文件（已存在于 GitHub Releases）
release/
*.7z

# 忽略日志
logs/

# 根目录误存的 CI 运行日志（GitHub Actions runner 输出，含 runner 绝对路径，无保留价值）
_*.log

# 一次性临时推送脚本（绕过 git 直接调 GitHub API 时产生，不属于项目代码）
_api_push*.py

# 忽略开发文档
开发手册/

# 忽略脚本目录，仅精确放行发布相关脚本
scripts/*
!scripts/1.一键打包.py

*.pyc
*.pyo
.venv/

# 输入法/第三方工具在本目录留下的日志
debug.log

tree.txt
# CI 下载的临时产物
_ci_linux/


_ci_mac_arm/
_ci_mac_x64/


# 本地 PDF 导出测试产物
_pdf_test.pdf

